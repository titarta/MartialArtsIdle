# Polyglyph TMS sync config — used by scripts/polyglyph-sync.mjs.
# Copy this file to `.env` (which is gitignored) and fill in the values.
# Never commit the real .env — POLYGLYPH_API_KEY is a secret.

# Base URL of your running Polyglyph backend (no trailing slash).
POLYGLYPH_BASE_URL=http://localhost:3000

# The X-Polyglyph-Key API key for your organisation (Polyglyph > Settings > API keys).
POLYGLYPH_API_KEY=

# The project slug to sync against (Polyglyph project URL / settings).
POLYGLYPH_PROJECT_SLUG=
